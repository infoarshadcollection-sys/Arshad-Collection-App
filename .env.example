# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The Supabase project URL for Arshad Collection (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Public anonymous key for client-side queries with Row Level Security (RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key

